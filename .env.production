# ── PostgreSQL ─────────────────────────────────────────────────────────
POSTGRES_PASSWORD="contrasena-segura"

# ── JWT ───────────────────────────────────────────────────────────────
# Generar: openssl rand -base64 48
JWT_SECRET="secreto-jwt"

# ── Encryption (Fernet) ───────────────────────────────────────────────
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY="clave-fernet"

# ── Groq AI ───────────────────────────────────────────────────────────
GROQ_API_KEY="gsk_api-key-de-groq"
# Default: openai/gpt-oss-120b (llama-3.3-70b-versatile se deprecia el 2026-08-16).
# Alternativa documentada como preview (NO activar aún, alcance proveedor = Groq):
#   qwen/qwen3.6-27b
GROQ_MODEL="openai/gpt-oss-120b"

# ── App ────────────────────────────────────────────────────────────────
LOG_LEVEL="info"

# ── Evolution API (WhatsApp Gateway - Hetzner) ──────────────────────────
EVO_API_KEY="api-key-segura-de-evolution"
EVO_DB_PASSWORD="contrasena-segura-para-evolution-db"

# ── CORS ──────────────────────────────────────────────────────────────
CORS_ORIGINS='OrigenesCORS'

# ── Dominio ────────────────────────────────────────────────────────────
# Dominio principal (dashboard / landing).
DOMAIN="nuncacierro.com"
# Dominio público servido por Caddy (SSL automático) — ver Caddyfile:
#   {domain}      → nc-dashboard (Next.js)
#   api.{domain}  → nc-api (FastAPI)
# Requerido por docker-compose (perfil caddy: ${CADDY_DOMAIN}).
# Configurable — cambiar aquí si el dominio cambia. Sin secretos.
CADDY_DOMAIN="nuncacierro.com"

# ── Webhooks / URLs públicas (Hetzner) ────────────────────────────────
# URL pública base de nc-api para callbacks de webhooks (Telegram, Evolution).
# Con Caddy: api.{DOMAIN} → nc-api. Sin secretos — solo infraestructura.
WEBHOOK_PUBLIC_BASE_URL="https://api.nuncacierro.com"
# URL interna de Docker usada cuando Evolution API y nc-api comparten red
# (intencional — no expuesta públicamente).
EVO_INTERNAL_BASE_URL="http://nc-api:8000"

# Pagos - leidas por GET /api/v1/billing/payment-info y el flujo de pago por WhatsApp
# del tenant interno (handler Evolution). Solo variables que el codigo soporta.
# Placeholders - completar con datos reales; NO inventar numeros.
PAYMENT_BREB_NUMBER="0092574368"
PAYMENT_ACCOUNT_HOLDER=""
PAYMENT_DASHBOARD_URL="https://nuncacierro.com/dashboard"
