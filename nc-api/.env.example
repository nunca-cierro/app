# ── Meta WhatsApp Cloud API ──────────────────────────────────────────────
# WHATSAPP_TOKEN and WHATSAPP_PHONE_NUMBER_ID have been removed.
# Set these per-business in businesses/<id>.json:
#   "whatsapp_token": "EAAx..."
#   "whatsapp_phone_number_id": "123456789"
WHATSAPP_VERIFY_TOKEN="tu_token_secreto_de_verificacion"
WHATSAPP_API_VERSION="v22.0"

# ── Security ─────────────────────────────────────────────────────────────
# JWT_SECRET: Used to sign JWT tokens for authentication
# Generate with: openssl rand -base64 32
JWT_SECRET="tu_secreto_jwt_aqui"

# ENCRYPTION_KEY: Used to encrypt sensitive data (WhatsApp tokens, API keys)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY="tu_clave_fernet_aqui"

# ── Groq API ─────────────────────────────────────────────────────────────
GROQ_API_KEY="gsk_..."
# Default model. Groq deprecated llama-3.3-70b-versatile (shutdown 2026-08-16).
# Replacement: openai/gpt-oss-120b (recommended) o qwen/qwen3.6-27b.
# Override por agente o con esta variable (rollback: volver al valor anterior).
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_MAX_TOKENS=512
GROQ_TEMPERATURE=0.7

# ── Database ──────────────────────────────────────────────────────────────
# PostgreSQL connection string (asyncpg driver)
# En producción (Hetzner) la define docker-compose / el .env del host.
# Format: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL="postgresql+asyncpg://postgres:1234@localhost:5432/nuncacierro"

# ── Evolution API (opcional) ──────────────────────────────────────────────
# Evolution API v2.x es una pasarela WhatsApp auto-hospedada.
# La configuracion (base_url, api_key, instance_name) se guarda por conexion
# en PlatformConnection.credentials (cifrado), no aca.
# Ejemplo de credentials para una conexion Evolution:
#
#   POST /api/v1/platform-connections
#   {
#     "tenant_id": "...",
#     "platform_type": "evolution",
#     "display_name": "WhatsApp Evolution",
#     "credentials": {
#       "base_url": "https://evo.nuncacierro.com",
#       "api_key": "tu-api-key",
#       "instance_name": "nuncacierro"
#     }
#   }

# ── App ──────────────────────────────────────────────────────────────────
APP_PORT=8000
APP_HOST="0.0.0.0"
LOG_LEVEL="INFO"

# ── Webhooks / URLs públicas ─────────────────────────────────────────────
# URL pública base de nc-api usada para armar las URLs de callback de los
# webhooks (Telegram, Evolution). En Hetzner con Caddy: https://api.nuncacierro.com
# WEBHOOK_PUBLIC_BASE_URL="https://api.nuncacierro.com"

# URL interna de Docker usada cuando Evolution API y nc-api comparten red
# (intencional — no expuesta públicamente). Override si viven en hosts distintos.
# EVO_INTERNAL_BASE_URL="http://nc-api:8000"

# ── Pagos ────────────────────────────────────────────────────────────────
# Leídas por GET /api/v1/billing/payment-info y por el flujo de pago por
# WhatsApp del tenant interno (handler de Evolution). Solo variables que el
# código realmente soporta. Placeholders — completar con los datos reales
# de la cuenta de cobro; NO inventar números.
PAYMENT_BREB_NUMBER=""
PAYMENT_ACCOUNT_HOLDER=""
PAYMENT_DASHBOARD_URL="https://nuncacierro.com/dashboard"
